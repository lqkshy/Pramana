# Pramana environment configuration
# Copy to .env and fill in real values. Values here mirror app.core.config.Settings.

APP_NAME=Pramana
ENVIRONMENT=development
LOG_LEVEL=INFO

OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

DATABASE_URL=sqlite+aiosqlite:///./pramana.db
REDIS_URL=redis://localhost:6379/0
